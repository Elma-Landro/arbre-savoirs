# Exemple de configuration — copie ce fichier en .env et renseigne les valeurs.
# SANS .env, le backend utilise automatiquement la clé détectée dans la config
# ZCode (provider builtin:zai-coding-plan) — aucune configuration requise.

# --- LLM (Anthropic-compatible par défaut) ----------------------------------
# Override de la clé LLM (sinon : config ZCode utilisée).
# ARBRE_LLM_API_KEY=...

# Override de l'endpoint LLM (par défaut : z.ai, compatible Anthropic).
# ARBRE_LLM_BASE_URL=https://api.z.ai/api/anthropic

# Override du modèle (par défaut : glm-4.6).
# ARBRE_LLM_MODEL=glm-4.6

# --- TTS --------------------------------------------------------------------
# gTTS est utilisé par défaut (gratuit, sans clé).
# Pour ElevenLabs (non implémenté en V2, voir BACKLOG.md) :
# ELEVENLABS_API_KEY=...
