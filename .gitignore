# =============================================================================
#  .gitignore — "L'Arbre des Savoirs" (MVP V2)
#  Exclut tout ce qui n'a pas sa place dans le dépôt : environnements virtuels,
#  dépendances installées, fichiers générés à l'exécution, secrets.
# =============================================================================

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/

# --- Node / Frontend --------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.vite/
*.local

# --- Fichiers générés à l'exécution ----------------------------------------
# Les fichiers audio TTS sont régénérés à la volée (gTTS) ; on ne les commit pas.
backend/audio_out/
*.mp3
# (sauf s'il s'agit d'un asset de test explicite — aucun pour l'instant)

# --- Secrets / configuration locale ----------------------------------------
.env
.env.*
!.env.example
*.key
secrets.json

# --- OS / éditeurs ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Logs / temporaires -----------------------------------------------------
*.log
/tmp/
.cache/
